; ============================================================
; autorun.inf – Déclencheur AutoRun pour clé USB
;
; Pré-requis : AutoRun doit être activé sur la machine cible.
;   Exécuter setup_target.ps1 une fois sur la machine cible
;   avant la démonstration (NoDriveTypeAutoRun = 0x00).
;
; Comportement attendu après setup_target.ps1 :
;   Insertion de la clé → Windows lit autorun.inf →
;   launcher.vbs s'exécute automatiquement, sans clic.
; ============================================================
[autorun]
open=launcher.vbs
icon=shell32.dll,8
label=USB Stockage
